### Create client
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "fullName": "Иван Петров",
  "email": "ivan@mail.ru",
  "phone": "+78888888888",
  "role": "CLIENT"
}

### Create picker
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "fullName": "Ольга Сидорова",
  "email": "olga@mail.ru",
  "phone": "+79999999999",
  "role": "PICKER"
}

### Create product 1
POST http://localhost:8080/api/products
Content-Type: application/json

{
  "name": "Бананы",
  "description": "Свежие бананы",
  "price": 3.40,
  "availableQuantity": 50,
  "qualityStatus": "GOOD"
}

### Create product 2
POST http://localhost:8080/api/products
Content-Type: application/json

{
  "name": "Яблоки",
  "description": "Красные яблоки",
  "price": 4.10,
  "availableQuantity": 30,
  "qualityStatus": "GOOD"
}

### Create order
POST http://localhost:8080/api/orders
Content-Type: application/json

{
  "clientId": 1,
  "pickerId": 2,
  "deliveryAddress": "Минск, улица Независимости, 10",
  "comment": "Позвоните, если бананы покажутся поврежденными",
  "items": [
    {"productId": 1, "quantity": 2},
    {"productId": 2, "quantity": 3}
  ]
}

### Change status
PATCH http://localhost:8080/api/orders/1/status
Content-Type: application/json

{
  "changedByUserId": 2,
  "newStatus": "ASSEMBLING",
  "comment": "Сборщик приступил к сборке"
}

### Send chat message
POST http://localhost:8080/api/orders/1/messages
Content-Type: application/json

{
  "senderId": 2,
  "message": "Бананы слишком спелые. Могу ли я заменить их бананами высшего сорта?"
}

### Create replacement proposal
POST http://localhost:8080/api/orders/1/replacements
Content-Type: application/json

{
  "originalProductId": 1,
  "proposedProductId": 2,
  "createdByUserId": 2,
  "reason": "Оригинальные бананы не соответствуют требованиям к качеству"
}

### Approve replacement
PATCH http://localhost:8080/api/replacements/1/decision
Content-Type: application/json

{
  "status": "APPROVED",
  "clientComment": "Одобрено"
}